{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "야생학습",
  "mainBinaryName": "wild-learning",
  "version": "../package.json",
  "identifier": "dev.younggeun0.wild-learning",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "야생학습",
        "width": 320,
        "height": 300,
        "minWidth": 200,
        "minHeight": 90,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
